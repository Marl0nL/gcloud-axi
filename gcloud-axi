#!/usr/bin/env python3
"""gcloud-axi - agent-ergonomic CLI wrapper around gcloud.

This file is safe to symlink onto PATH; it resolves its own real location so
the package next to it is importable regardless of where the symlink lives.
"""

import os
import sys

_ROOT = os.path.dirname(os.path.realpath(__file__))
_SRC = os.path.join(_ROOT, "src")
if _SRC not in sys.path:
    sys.path.insert(0, _SRC)

from gcloud_axi.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
